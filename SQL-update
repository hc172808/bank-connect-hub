#!/usr/bin/env bash
#
# NETLIFE CASH — create or update the requested administrator account.
#
# Usage:
#   sudo ./SQL-update
#
# The script uses the self-hosted Supabase service-role key only on the server.
# It prompts for the password without echoing or saving it. Do not put the
# password in this file or commit it to Git.
#
set -euo pipefail

PHONE="${ADMIN_PHONE:-6421651}"
FULL_NAME="${ADMIN_FULL_NAME:-Administrator}"
APP_ENV="${APP_ENV:-/opt/netlifecash/.env}"
SUPABASE_ENV="${SUPABASE_ENV:-/opt/supabase/docker/.env}"
PHONE="$(printf '%s' "$PHONE" | tr -cd '0-9')"
EMAIL="${PHONE}@vbank.com"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
die() { echo -e "${RED}Error:${NC} $*" >&2; exit 1; }
ok() { echo -e "${GREEN}OK:${NC} $*"; }
warn() { echo -e "${YELLOW}Warning:${NC} $*"; }

[[ $EUID -eq 0 ]] || die "Run as root: sudo ./SQL-update"
command -v curl >/dev/null 2>&1 || die "curl is required"
command -v jq >/dev/null 2>&1 || die "jq is required"

read_env_value() {
  local key="$1" file="$2"
  [[ -f "$file" ]] || return 0
  awk -F= -v key="$key" '
    $1 == key {
      value = substr($0, index($0, "=") + 1)
      gsub(/^["'\''"]|["'\''"]$/, "", value)
      print value
      exit
    }
  ' "$file"
}

first_env_value() {
  local key value file
  for file in "$APP_ENV" "$SUPABASE_ENV" "${PWD}/.env" "${PWD}/db-server/.env"; do
    value="$(read_env_value "$1" "$file" || true)"
    if [[ -n "$value" ]]; then
      printf '%s' "$value"
      return 0
    fi
  done
}

SUPABASE_URL="${SUPABASE_URL:-$(first_env_value VITE_SUPABASE_URL || true)}"
SUPABASE_URL="${SUPABASE_URL:-$(first_env_value API_EXTERNAL_URL || true)}"
SUPABASE_URL="${SUPABASE_URL:-$(first_env_value SUPABASE_PUBLIC_URL || true)}"
SUPABASE_URL="${SUPABASE_URL:-http://127.0.0.1:8000}"
SUPABASE_URL="${SUPABASE_URL%/}"

SERVICE_ROLE_KEY="${SUPABASE_SERVICE_ROLE_KEY:-}"
SERVICE_ROLE_KEY="${SERVICE_ROLE_KEY:-$(first_env_value SUPABASE_SERVICE_ROLE_KEY || true)}"
SERVICE_ROLE_KEY="${SERVICE_ROLE_KEY:-$(first_env_value SERVICE_ROLE_KEY || true)}"
[[ -n "$SERVICE_ROLE_KEY" ]] || die "No Supabase service-role key found in ${APP_ENV} or ${SUPABASE_ENV}"

read -r -s -p "Enter the administrator password for ${PHONE}: " ADMIN_PASSWORD
echo
read -r -s -p "Confirm the administrator password: " ADMIN_PASSWORD_CONFIRM
echo
[[ -n "$ADMIN_PASSWORD" ]] || die "Password cannot be empty"
[[ "$ADMIN_PASSWORD" == "$ADMIN_PASSWORD_CONFIRM" ]] || die "Passwords do not match"
unset ADMIN_PASSWORD_CONFIRM

WORK_DIR="$(mktemp -d)"
trap 'rm -rf "$WORK_DIR"; unset ADMIN_PASSWORD SERVICE_ROLE_KEY' EXIT
REQUEST_FILE="${WORK_DIR}/request.json"
RESPONSE_FILE="${WORK_DIR}/response.json"

jq -n \
  --arg email "$EMAIL" \
  --arg password "$ADMIN_PASSWORD" \
  --arg phone "$PHONE" \
  --arg full_name "$FULL_NAME" \
  '{email: $email, password: $password, email_confirm: true,
    user_metadata: {phone_number: $phone, full_name: $full_name,
                    role: "admin", account_type: "admin"}}' \
  > "$REQUEST_FILE"
chmod 600 "$REQUEST_FILE"

admin_api() {
  local method="$1" url="$2" output="$3"
  shift 3
  curl -sS -X "$method" "$url" \
    -H "apikey: ${SERVICE_ROLE_KEY}" \
    -H "Authorization: Bearer ${SERVICE_ROLE_KEY}" \
    -H "Content-Type: application/json" \
    "$@" -o "$output" -w '%{http_code}'
}

CREATE_CODE="$(admin_api POST "${SUPABASE_URL}/auth/v1/admin/users" "$RESPONSE_FILE" \
  --data-binary "@${REQUEST_FILE}")"
USER_ID=""

if [[ "$CREATE_CODE" == "200" || "$CREATE_CODE" == "201" ]]; then
  USER_ID="$(jq -r '.id // empty' "$RESPONSE_FILE")"
  ok "Created Auth user ${EMAIL}"
elif [[ "$CREATE_CODE" == "422" || "$CREATE_CODE" == "409" ]]; then
  LIST_FILE="${WORK_DIR}/users.json"
  LIST_CODE="$(admin_api GET "${SUPABASE_URL}/auth/v1/admin/users?page=1&per_page=1000" "$LIST_FILE")"
  [[ "$LIST_CODE" == "200" ]] || die "Could not list existing Auth users (HTTP ${LIST_CODE})"
  USER_ID="$(jq -r --arg email "$EMAIL" '.users[]? | select(.email == $email) | .id' "$LIST_FILE" | head -n 1)"
  [[ -n "$USER_ID" ]] || die "Auth user exists but could not be located"

  UPDATE_CODE="$(admin_api PUT "${SUPABASE_URL}/auth/v1/admin/users/${USER_ID}" "$RESPONSE_FILE" \
    --data-binary "@${REQUEST_FILE}")"
  [[ "$UPDATE_CODE" == "200" ]] || die "Could not update existing Auth user (HTTP ${UPDATE_CODE})"
  ok "Updated Auth user ${EMAIL}"
else
  detail="$(jq -r '.msg // .message // .error_description // empty' "$RESPONSE_FILE" 2>/dev/null || true)"
  die "Supabase Auth request failed (HTTP ${CREATE_CODE})${detail:+: $detail}"
fi

[[ "$USER_ID" =~ ^[0-9a-fA-F-]{36}$ ]] || die "Supabase returned an invalid user ID"

POSTGRES_PASSWORD="$(first_env_value POSTGRES_PASSWORD || true)"
POSTGRES_DB="$(first_env_value POSTGRES_DB || true)"
POSTGRES_DB="${POSTGRES_DB:-postgres}"
POSTGRES_USER="$(first_env_value POSTGRES_USER || true)"
POSTGRES_USER="${POSTGRES_USER:-postgres}"
DB_CONTAINER="${SUPABASE_DB_CONTAINER:-supabase-db}"

SQL_FILE="${WORK_DIR}/role-update.sql"
cat > "$SQL_FILE" <<'SQL'
BEGIN;

INSERT INTO public.profiles (id, full_name, phone_number)
VALUES (:'user_id', :'full_name', :'phone_number')
ON CONFLICT (id) DO UPDATE
SET full_name = EXCLUDED.full_name,
    phone_number = EXCLUDED.phone_number,
    updated_at = now();

DELETE FROM public.user_roles
WHERE user_id = :'user_id' AND role <> 'admin'::public.app_role;

INSERT INTO public.user_roles (user_id, role)
VALUES (:'user_id', 'admin'::public.app_role)
ON CONFLICT (user_id, role) DO NOTHING;

UPDATE auth.users
SET raw_user_meta_data =
      coalesce(raw_user_meta_data, '{}'::jsonb)
      || jsonb_build_object(
           'phone_number', :'phone_number',
           'full_name', :'full_name',
           'role', 'admin',
           'account_type', 'admin'
         ),
    updated_at = now()
WHERE id = :'user_id';

COMMIT;
SQL
chmod 600 "$SQL_FILE"

if command -v docker >/dev/null 2>&1 && docker inspect "$DB_CONTAINER" >/dev/null 2>&1; then
  docker exec -i "$DB_CONTAINER" psql \
    -U "$POSTGRES_USER" -d "$POSTGRES_DB" \
    -v user_id="$USER_ID" \
    -v phone_number="$PHONE" \
    -v full_name="$FULL_NAME" \
    < "$SQL_FILE"
else
  command -v psql >/dev/null 2>&1 || die "Neither ${DB_CONTAINER} nor the host psql client is available"
  DATABASE_URL="$(first_env_value DATABASE_URL || true)"
  [[ -n "$DATABASE_URL" ]] || die "No DATABASE_URL available for the PostgreSQL role update"
  PGPASSWORD="$POSTGRES_PASSWORD" psql "$DATABASE_URL" \
    -v user_id="$USER_ID" \
    -v phone_number="$PHONE" \
    -v full_name="$FULL_NAME" \
    -f "$SQL_FILE"
fi

unset ADMIN_PASSWORD
ok "Administrator role applied for ${PHONE}"
echo "Sign in with the phone number ${PHONE} and the password you entered."