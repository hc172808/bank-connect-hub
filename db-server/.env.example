# ── PostgreSQL ────────────────────────────────
DATABASE_MODE=local
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=netlifecash
POSTGRES_PORT=5432

# ── pgAdmin ───────────────────────────────────
PGADMIN_EMAIL=admin@netlifecash.com
PGADMIN_PASSWORD=change-me-strong-password
PGADMIN_PORT=5050

# The application connection string generated by npm run db:setup:
# DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/netlifecash
