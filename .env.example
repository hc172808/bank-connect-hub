# ─────────────────────────────────────────────────────────────────────────────
# Virtual Bank — Environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Docker image source ────────────────────────────────────────────────────
# Your GitHub username (lowercase)
GITHUB_USER=your-github-username

# Your GitHub repository name (lowercase)
GITHUB_REPO=your-repo-name

# ── Port the app will be available on the host ─────────────────────────────
APP_PORT=3000

# ── Webhook port (for instant redeploy from GitHub Actions) ───────────────
WEBHOOK_PORT=9000

# ── Watchtower polling interval (seconds) ─────────────────────────────────
WATCHTOWER_INTERVAL=300

# ── Optional: Slack/Discord notification webhook for Watchtower ───────────
# WATCHTOWER_NOTIFY_URL=https://hooks.slack.com/...
