# ═══════════════════════════════════════════════════════════════════════════════
# Virtual Bank (NETLIFE CASH) — Ubuntu 22.04 + PostgreSQL Environment
#
# SETUP:
#   cp .env.ubuntu.example .env
#   nano .env            ← fill in YOUR values
#
# Then run:
#   sudo -u postgres psql -c "CREATE DATABASE virtualbank;"
#   sudo -u postgres psql -d virtualbank -f postgres-setup.sql
#   npm run build        ← build the frontend
#   npm start            ← or use PM2 / systemd (see UBUNTU_POSTGRES_SETUP.md)
# ═══════════════════════════════════════════════════════════════════════════════

# ── Node environment ──────────────────────────────────────────────────────────
NODE_ENV=production

# ── Ports ─────────────────────────────────────────────────────────────────────
# Port the Vite-built frontend is served on (nginx proxies to this)
PORT=5000

# Port for the build-server (APK builder, SMS, email, push notifications)
BUILD_SERVER_PORT=3001

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Connection string for the build-server (server-side only, never exposed to browser)
DATABASE_URL=postgresql://virtualbank_app:CHANGE_ME_PASSWORD@localhost:5432/virtualbank

# Individual fields (used by some scripts)
PGHOST=localhost
PGPORT=5432
PGDATABASE=virtualbank
PGUSER=virtualbank_app
PGPASSWORD=CHANGE_ME_PASSWORD

# ── Supabase-compatible API (self-hosted GoTrue / PostgREST) ──────────────────
# If you are running self-hosted Supabase on the same server, point these at it.
# If NOT using Supabase at all, set these to your PostgREST / GoTrue endpoints.
#
# For a PURE PostgreSQL setup without Supabase, leave these blank and
# implement auth in the build-server (see UBUNTU_POSTGRES_SETUP.md §Auth).
VITE_SUPABASE_URL=http://YOUR_SERVER_IP_OR_DOMAIN:8000
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_KEY_HERE
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF_HERE

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must match the JWT_SECRET used by GoTrue (Supabase auth) or your own auth layer.
# Generate a strong secret:  openssl rand -hex 64
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHARACTER_STRING

# ── WhatsApp support ──────────────────────────────────────────────────────────
# International format without leading +
VITE_WHATSAPP_SUPPORT_NUMBER=5926421651

# ── Web Push Notifications (VAPID) ───────────────────────────────────────────
# Generate once:
#   node -e "const w=require('web-push'); const k=w.generateVAPIDKeys(); console.log(JSON.stringify(k,null,2))"
# Leave blank in dev — build-server auto-generates and saves to .local/vapid.json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=admin@yourdomain.com

# ── SMS Alerts via Twilio (optional) ─────────────────────────────────────────
# Leave ALL blank to disable SMS — the app works without it.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Email Alerts via SMTP (optional) ─────────────────────────────────────────
# Works with Gmail, Brevo, Mailgun, Amazon SES, etc.
# Leave ALL blank to disable email — the app works without it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourdomain.com
SMTP_FROM_NAME=NETLIFE CASH

# ── Blockchain / RPC (optional) ───────────────────────────────────────────────
UPSTREAM_RPC=https://bsc-dataseed.binance.org

# ── Domain & SSL ──────────────────────────────────────────────────────────────
# Your server's domain name (leave blank to use the server's IP)
DOMAIN_NAME=
# Email for Let's Encrypt SSL (leave blank to skip SSL)
SSL_EMAIL=
